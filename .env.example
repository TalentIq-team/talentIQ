# ==========================================
# TalentIQ - Environment Variables Example
# ==========================================
# DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy this to `.env` for Docker/local tools if needed, 
# but use `dotnet user-secrets` for the .NET API.

# 1. Database (SQL Server via Docker Compose)
ConnectionStrings__Default=Server=localhost,1433;Database=TalentIQ;User Id=sa;Password=TalentIq2026!Secure;TrustServerCertificate=True

# 2. Security (JWT Authentication)
JWT_SIGNING_KEY=your-placeholder-jwt-signing-key-minimum-32-chars-long

# 3. AI Provider (Google Gemini API)
# Get the shared development key from the team lead.
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Storage (Azurite Blob Storage Emulator via Docker Compose)
BLOB_CONNECTION_STRING=UseDevelopmentStorage=true

# 5. Notifications (Mailpit SMTP Sink via Docker Compose)
SMTP_HOST=localhost
SMTP_PORT=1025