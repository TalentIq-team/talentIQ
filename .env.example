# ==========================================
# TalentIQ - Environment Variables (template)
# ==========================================
# Copy this file to ".env" and fill in real values. ".env" is git-ignored and
# is loaded automatically at startup by src/TalentIQ.Api/Program.cs.
# Variable names use "__" which .NET maps to the ":" config hierarchy
# (e.g. ConnectionStrings__Default -> ConnectionStrings:Default).

# 1. Database (SQL Server via docker-compose, host port 11433)
# MSSQL_SA_PASSWORD provisions the SQL container; keep it identical to the
# Password used in the connection strings below.
MSSQL_SA_PASSWORD=CHANGE_ME
ConnectionStrings__Default="Server=localhost,11433;Database=TalentIQ;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True"
ConnectionStrings__DefaultConnection="Server=localhost,11433;Database=TalentIQ;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True"

# 2. JWT — Identity signs tokens and the API validates them with the same key.
#    Use the SAME value for both. Minimum 32 characters.
Jwt__Key=CHANGE_ME_minimum_32_characters_long
Jwt__SigningKey=CHANGE_ME_minimum_32_characters_long
Jwt__Issuer=TalentIQ.Api
Jwt__Audience=TalentIQ.Client

# 3. AI provider (Google Gemini). Leave blank to use the rule-based fallback.
Gemini__ApiKey=

# 4. SMTP (interview invitation emails). The Mailpit dev sink needs no auth.
EmailSettings__Username=
EmailSettings__Password=
